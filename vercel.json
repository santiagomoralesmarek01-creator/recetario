{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:ruta*",
      "has": [
        {
          "type": "host",
          "value": "recetario-virid.vercel.app"
        }
      ],
      "destination": "https://www.amanorecetas.com.ar/:ruta*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!api/|data/|img/|css/|js/|docs/)(?!.*\\.[A-Za-z0-9]{2,12}$).*)",
      "destination": "/api/pagina?ruta=$1"
    }
  ],
  "functions": {
    "api/pagina.js": {
      "includeFiles": "{index.html,data/recetas-casa.json,data/mealdb/*.json}"
    },
    "api/sitemap.js": {
      "includeFiles": "{data/recetas-casa.json,data/mealdb/indice.json}"
    }
  }
}
